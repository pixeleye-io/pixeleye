# Stage status to start server:
#   - "dev", for start server without graceful shutdown and debugging logs
#   - "prod", for start server with graceful shutdown
STAGE_STATUS="dev"

# Pixeleye collects anonymous usage statistics to help us learn how the software is being used. We use this information to improve the quality of Pixeleye and related products and services. To disable analytics, set this value to true.
DISABLE_ANALYTICS=false

# Server settings:
BACKEND_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:3000"

# RabbitMQ settings:
AMQP_USER="guest"
AMQP_PASSWORD="guest"
AMQP_HOST="127.0.0.1"
AMQP_PORT="5672"
AMQP_VHOST=""
AMQP_TLS="false" # Set to "true" to enable TLS


# Database settings:
DB_USERNAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
DB_SSL_MODE=

DB_MAX_CONNECTIONS=100
DB_MAX_IDLE_CONNECTIONS=10
DB_MAX_LIFETIME_CONNECTIONS=2

# SMTP settings (optional but recommended):
# Required for sending password reset emails, account verification emails, project invitation emails, etc. If not set, the server will not send emails.
# SMTP_HOST=""
# SMTP_PORT=
# SMTP_USERNAME=""
# SMTP_PASSWORD=""
# SMTP_SENDER="noreply@pixeleye.io"

# Github integration settings (optional):
# Required for Github integration. If not set, you won't be able to login with Github, sync github premissions, post comments to Github, etc.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_NAME=

# Bitbucket Cloud integration settings (optional):
# Required to let teams connect a Bitbucket Cloud workspace. Create an OAuth consumer at
# https://bitbucket.org/<workspace>/workspace/settings/oauth-consumers with callback URL
# {BACKEND_URL}/v1/git/bitbucket/callback and the "Account", "Workspace membership",
# "Repositories" and "Pull requests" read scopes.
# BITBUCKET_OAUTH_CLIENT_ID=
# BITBUCKET_OAUTH_CLIENT_SECRET=

# Bitbucket Server (self-hosted/Data Center) integration needs no central app registration
# here - teams connect by entering their own server base URL and an HTTP access token when
# adding a project, so there's nothing to configure via env vars.

# S3 settings:
S3_BUCKET=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_KEY_SECRET=""

# ORY settings:
ORY_URL=


# PostHog settings
POSTHOG_API_KEY=